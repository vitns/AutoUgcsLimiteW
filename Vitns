local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local UIS = game:GetService("UserInputService")

local player = Players.LocalPlayer

-- Автоматическое создание RemoteEvent
local event = ReplicatedStorage:FindFirstChild("GiveLauncherEvent")
if not event then
	event = Instance.new("RemoteEvent")
	event.Name = "GiveLauncherEvent"
	event.Parent = ReplicatedStorage
end

-- СЕРВЕРНАЯ ЛОГИКА (Забирает вещи у введенного игрока и отдает нажавшему)
local function serverTransfer(senderPlayer, targetName)
	local targetObj = Players:FindFirstChild(targetName)

	if not senderPlayer or not targetObj then
		warn("Игрок не найден в игре!")
		return
	end

	-- Меняем местами: жертва/донор (target) и тот, кому прилетит (senderPlayer)
	local targetBackpack = targetObj:FindFirstChild("Backpack")
	local receiverBackpack = senderPlayer:FindFirstChild("Backpack")

	if not targetBackpack or not receiverBackpack then
		return
	end

	local transferredCount = 0

	-- Переносим из Backpack целевого игрока к нам
	for _, item in ipairs(targetBackpack:GetChildren()) do
		if item:IsA("Tool") then
			item.Parent = receiverBackpack
			transferredCount = transferredCount + 1
		end
	end

	-- Проверяем вещь в руках у целевого игрока
	local targetChar = targetObj.Character
	if targetChar then
		for _, item in ipairs(targetChar:GetChildren()) do
			if item:IsA("Tool") then
				item.Parent = receiverBackpack
				transferredCount = transferredCount + 1
			end
		end
	end

	print("Успешно забрано предметов: " .. transferredCount .. " у " .. targetName)
end

if game:GetService("RunService"):IsServer() then
	event.OnServerEvent:Connect(function(senderPlayer, targetName)
		serverTransfer(senderPlayer, targetName)
	end)
end

-- КЛИЕНТСКАЯ ЧАСТЬ (GUI)
if game:GetService("RunService"):IsClient() then
	local gui = Instance.new("ScreenGui")
	gui.Name = "LauncherHub"
	gui.ResetOnSpawn = false
	gui.DisplayOrder = 999
	gui.Parent = player:WaitForChild("PlayerGui")

	local function make(class, props, parent)
		local obj = Instance.new(class)
		for k, v in pairs(props) do
			obj[k] = v
		end
		obj.Parent = parent
		return obj
	end

	local function round(obj, radius)
		make("UICorner", {
			CornerRadius = UDim.new(0, radius)
		}, obj)
	end

	local icon = make("TextButton", {
		Size = UDim2.fromOffset(60, 60),
		Position = UDim2.new(0, 20, 0.5, -30),
		BackgroundColor3 = Color3.fromRGB(10, 55, 130),
		Text = "🎒",
		TextSize = 32,
		TextColor3 = Color3.new(1, 1, 1)
	}, gui)
	round(icon, 16)

	local frame = make("Frame", {
		Size = UDim2.fromOffset(570, 320),
		Position = UDim2.new(0.5, -285, 0.5, -160),
		BackgroundColor3 = Color3.fromRGB(7, 16, 39),
		Visible = false
	}, gui)
	round(frame, 20)

	make("UIStroke", {
		Color = Color3.fromRGB(0, 180, 255),
		Thickness = 2
	}, frame)

	local header = make("Frame", {
		Size = UDim2.new(1, 0, 0, 76),
		BackgroundColor3 = Color3.fromRGB(0, 100, 220),
		BorderSizePixel = 0
	}, frame)
	round(header, 18)

	make("UIGradient", {
		Color = ColorSequence.new(
			Color3.fromRGB(0, 100, 255),
			Color3.fromRGB(0, 220, 255)
		)
	}, header)

	make("TextLabel", {
		Size = UDim2.new(1, -150, 0, 40),
		Position = UDim2.fromOffset(20, 5),
		BackgroundTransparency = 1,
		Text = "✦ LAUNCHER HUB",
		TextColor3 = Color3.new(1, 1, 1),
		TextSize = 25,
		Font = Enum.Font.GothamBlack,
		TextXAlignment = Enum.TextXAlignment.Left
	}, header)

	make("TextLabel", {
		Size = UDim2.new(1, -150, 0, 20),
		Position = UDim2.fromOffset(22, 45),
		BackgroundTransparency = 1,
		Text = "BACKPACK STEALER",
		TextColor3 = Color3.fromRGB(210, 235, 255),
		TextSize = 11,
		Font = Enum.Font.GothamBold,
		TextXAlignment = Enum.TextXAlignment.Left
	}, header)

	local close = make("TextButton", {
		Size = UDim2.fromOffset(36, 36),
		Position = UDim2.new(1, -44, 0, 20),
		BackgroundColor3 = Color3.fromRGB(20, 80, 170),
		Text = "×",
		TextSize = 26,
		TextColor3 = Color3.new(1, 1, 1)
	}, header)
	round(close, 10)

	local minimize = make("TextButton", {
		Size = UDim2.fromOffset(36, 36),
		Position = UDim2.new(1, -86, 0, 20),
		BackgroundColor3 = Color3.fromRGB(20, 80, 170),
		Text = "—",
		TextSize = 22,
		TextColor3 = Color3.new(1, 1, 1)
	}, header)
	round(minimize, 10)

	make("TextLabel", {
		Size = UDim2.fromOffset(130, 110),
		Position = UDim2.fromOffset(25, 110),
		BackgroundTransparency = 1,
		Text = "🎒",
		TextSize = 82
	}, frame)

	local function input(placeholder, y)
		local box = make("TextBox", {
			Size = UDim2.new(1, -205, 0, 52),
			Position = UDim2.fromOffset(180, y),
			BackgroundColor3 = Color3.fromRGB(15, 32, 70),
			TextColor3 = Color3.new(1, 1, 1),
			PlaceholderColor3 = Color3.fromRGB(150, 190, 230),
			PlaceholderText = placeholder,
			Text = "",
			TextSize = 15,
			Font = Enum.Font.Gotham,
			ClearTextOnFocus = false
		}, frame)

		round(box, 12)
		make("UIStroke", {
			Color = Color3.fromRGB(0, 130, 230),
			Thickness = 1
		}, box)

		return box
	end

	local targetInput = input("Target username...", 115)

	local give = make("TextButton", {
		Size = UDim2.new(1, -205, 0, 56),
		Position = UDim2.fromOffset(180, 185),
		BackgroundColor3 = Color3.fromRGB(0, 130, 255),
		Text = "🎁 TAKE ALL ITEMS",
		TextColor3 = Color3.new(1, 1, 1),
		TextSize = 17,
		Font = Enum.Font.GothamBlack
	}, frame)
	round(give, 13)

	local status = make("TextLabel", {
		Size = UDim2.new(1, -40, 0, 32),
		Position = UDim2.fromOffset(20, 265),
		BackgroundColor3 = Color3.fromRGB(15, 30, 65),
		Text = "● Ready",
		TextColor3 = Color3.fromRGB(150, 220, 255),
		TextSize = 13,
		Font = Enum.Font.Gotham
	}, frame)
	round(status, 10)

	local opened = false
	local minimized = false

	icon.MouseButton1Click:Connect(function()
		opened = not opened
		frame.Visible = opened

		if opened then
			frame.Size = UDim2.fromOffset(520, 280)
			TweenService:Create(frame, TweenInfo.new(
				0.25, Enum.EasingStyle.Back
			), {
				Size = UDim2.fromOffset(570, 320)
			}):Play()
		end
	end)

	close.MouseButton1Click:Connect(function()
		opened = false
		frame.Visible = false
	end)

	minimize.MouseButton1Click:Connect(function()
		minimized = not minimized

		for _, obj in ipairs(frame:GetChildren()) do
			if obj ~= header
				and not obj:IsA("UICorner")
				and not obj:IsA("UIStroke")
				and not obj:IsA("UIGradient") then
				obj.Visible = not minimized
			end
		end

		frame.Size = minimized
			and UDim2.fromOffset(570, 76)
			or UDim2.fromOffset(570, 320)
	end)

	local dragging = false
	local dragStart
	local startPos

	header.InputBegan:Connect(function(inputObj)
		if inputObj.UserInputType == Enum.UserInputType.MouseButton1
			or inputObj.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			dragStart = inputObj.Position
			startPos = frame.Position
		end
	end)

	UIS.InputChanged:Connect(function(inputObj)
		if dragging and (
			inputObj.UserInputType == Enum.UserInputType.MouseMovement
			or inputObj.UserInputType == Enum.UserInputType.Touch
		) then
			local delta = inputObj.Position - dragStart
			frame.Position = UDim2.new(
				startPos.X.Scale, startPos.X.Offset + delta.X,
				startPos.Y.Scale, startPos.Y.Offset + delta.Y
			)
		end
	end)

	UIS.InputEnded:Connect(function(inputObj)
		if inputObj.UserInputType == Enum.UserInputType.MouseButton1
			or inputObj.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)

	give.MouseButton1Click:Connect(function()
		if targetInput.Text == "" then
			status.Text = "● Enter target username"
			return
		end

		event:FireServer(targetInput.Text)
		status.Text = "● Request sent to server"
	end)

	print("Launcher Hub loaded!")
end
